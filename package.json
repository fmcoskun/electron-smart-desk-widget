{
  "name": "smart-desk",
  "version": "1.0.0",
  "description": "Smart Desk & Office IoT Controller - Electron desktop widget",
  "main": "main.js",
  "author": "tatariamurat <tatariamurat@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.smartdesk.widget",
    "productName": "Smart Desk Hub",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/bootstrap-icons/font/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "bootstrap-icons": "^1.11.3"
  }
}
